{
  "name": "hoo-monorepo",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "build": "bun run --cwd apps/desktop build",
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build"
  }
}
