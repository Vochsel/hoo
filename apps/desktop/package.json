{
  "name": "@hoo/desktop",
  "productName": "Hoo",
  "version": "0.3.0",
  "description": "Extracted Electron browser-automation app (tabs-as-nodes + settings/env + graph execution)",
  "main": "./out/main/index.js",
  "scripts": {
    "rebuild:native": "electron-rebuild -f -w better-sqlite3,node-pty",
    "dev": "bun run rebuild:native && electron-vite dev",
    "build": "electron-vite build",
    "dist:mac:arm64": "bun run build && electron-builder --mac --arm64 --publish never",
    "dist:win:x64": "bun run build && electron-builder --win --x64 --publish never",
    "preview": "electron-vite preview",
    "typecheck:main": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.46",
    "@ai-sdk/openai": "^3.0.30",
    "@electron-toolkit/utils": "^3.0.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-bold": "^2.11.5",
    "@tiptap/extension-bullet-list": "^2.11.5",
    "@tiptap/extension-document": "^2.11.5",
    "@tiptap/extension-heading": "^2.11.5",
    "@tiptap/extension-history": "^2.11.5",
    "@tiptap/extension-italic": "^2.11.5",
    "@tiptap/extension-list-item": "^2.11.5",
    "@tiptap/extension-paragraph": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-text": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/suggestion": "^2.11.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.0",
    "ai": "^6.0.97",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.39.3",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.469.0",
    "marked": "^17.0.3",
    "nanoid": "^5.1.2",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tippy.js": "^6.3.7",
    "turndown": "^7.2.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^3.7.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "37",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
